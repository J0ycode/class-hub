# ---- Hosted mode (Vercel): Upstash Redis ----
# Create an Upstash Redis database from the Vercel Marketplace and copy the
# REST URL + token here. The integration may name them KV_REST_API_* instead —
# either name works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Hosted mode: Vercel Blob (private notes) ----
# Create a Blob store in Vercel and copy its read/write token.
BLOB_READ_WRITE_TOKEN=

# ---- First admin account (only used when no users exist yet) ----
# Required on Vercel. Locally, a random password is printed to the console if unset.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# ---- Session cookie signing ----
# Any long random string (32+ characters). Required on Vercel so sessions
# survive redeploys; locally a data/secret.key file is used instead.
SESSION_SECRET=

# Locally you do not need any of these: the app falls back to data/store.json
# and ../ones_materials.
